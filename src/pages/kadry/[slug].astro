---
import Teren from "../../layouts/Teren.astro";
import { getCollection } from "astro:content";
import site, { coverFor } from "../../site.config";
export async function getStaticPaths() {
  const posts = await getCollection("kadry");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverFor(post.data.habitat, post.data.image);
const date = post.data.pubDate.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
const pile = (await getCollection("kadry")).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const here = pile.findIndex((p) => p.slug === post.slug);
const newer = here > 0 ? pile[here - 1] : null;
const older = here >= 0 && here < pile.length - 1 ? pile[here + 1] : null;
const also = pile.filter((p) => p.slug !== post.slug).slice(0, 3);

---
<Teren title={post.data.title} description={post.data.description} image={cover}>
  <article>
    <img src={cover} alt="" class="max-h-[60vh] w-full object-cover" />
    <div class="mx-auto max-w-3xl px-4 py-10">
      <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-dusk">{post.data.habitat} · {post.data.season} · {date}</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight md:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg italic text-mist">{post.data.description}</p>
      <div class="mt-6 flex items-center gap-3 text-sm">
        <img src={site.authorAvatar} alt="" class="h-11 w-11 rounded-full object-cover ring-2 ring-lichen/40" />
        <div>
          <p class="font-semibold text-fog">{post.data.author || site.author}</p>
          <p class="text-xs text-mist">{post.data.authorBio || site.authorBio}</p>
        </div>
      </div>
      <div class="prose prose-invert prose-headings:font-display prose-a:text-lichen mt-12 max-w-none prose-p:text-fog/90">
        <Content />
      </div>
    </div>
  </article>

<section class="mx-auto max-w-3xl px-4 pb-20">
  <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-dusk">Sąsiednie kadry</p>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {also.map((item) => (
      <a href={"/kadry/" + item.slug + "/"}>
        <img src={item.data.image} alt="" class="aspect-[4/3] w-full object-cover" />
        <p class="mt-2 text-sm text-fog">{item.data.title}</p>
      </a>
    ))}
  </div>
  <div class="mt-6 flex justify-between text-sm text-lichen">
    {older && <a href={"/kadry/" + older.slug + "/"}>← {older.data.title}</a>}
    {newer && <a href={"/kadry/" + newer.slug + "/"}>{newer.data.title} →</a>}
  </div>
</section>
</Teren>
