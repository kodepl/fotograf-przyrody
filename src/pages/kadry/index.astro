---
import Teren from "../../layouts/Teren.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";
const posts = (await getCollection("kadry")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Teren title="Kadry" description="Wszystkie notatki z terenu">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-5xl font-bold">Kadry</h1>
    <div class="mt-12 space-y-10">
      {posts.map((post, i) => (
        <article class="grid gap-6 border-b border-fog/10 pb-10 sm:grid-cols-[180px_1fr]">
          <a href={`/kadry/${post.slug}/`} class="film-edge block">
            <img src={coverFor(post.data.habitat, post.data.image)} alt="" class="aspect-[4/5] w-full object-cover" />
          </a>
          <div>
            <p class="text-[10px] uppercase tracking-widest text-dusk">{String(i + 1).padStart(2, "0")} · {post.data.habitat}</p>
            <h2 class="mt-2 font-display text-3xl font-semibold">
              <a href={`/kadry/${post.slug}/`} class="hover:text-lichen">{post.data.title}</a>
            </h2>
            <p class="mt-2 text-mist">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </main>
</Teren>
