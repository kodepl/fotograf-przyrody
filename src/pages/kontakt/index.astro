---
import Teren from "../../layouts/Teren.astro";
import site from "../../site.config";
---
<Teren title="Kontakt" description="Napisz">
  <main class="mx-auto max-w-xl px-4 py-12">
    <h1 class="font-display text-5xl font-bold">Kontakt</h1>
    <p class="mt-4 text-mist">{site.address}</p>
    <p class="mt-3"><u id="qfjd2" style="cursor:pointer;text-decoration:underline">Napisz do nas</u>
<script is:inline>
document.getElementById("qfjd2").addEventListener("click", function () {
  var salt = 319;
  var bits = "423-417-436-420-434-377-375-384-424-428-417-426-427-366-420-430-429".split("-");
  var s = "";
  for (var i = 0; i < bits.length; i++) s += String.fromCharCode(Number(bits[i]) - salt - (i % 3));
  this.textContent = s;
});
</script></p>
    <noscript><p class="mt-2 text-sm text-mist">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    </main>
</Teren>
