---
import Teren from "../../layouts/Teren.astro";
import site, { habitatSlug } from "../../site.config";
---
<Teren title="Siedliska" description="Gdzie powstają kadry">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-5xl font-bold">Siedliska</h1>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {site.habitats.map((h, i) => (
        <a href={`/siedliska/${habitatSlug(h.name)}/`} class="border border-fog/15 bg-bark/30 p-8 transition hover:border-lichen/50">
          <p class="text-dusk">{String(i + 1).padStart(2, "0")}</p>
          <h2 class="mt-2 font-display text-3xl font-semibold">{h.name}</h2>
          <p class="mt-3 text-sm text-mist">{h.blurb}</p>
        </a>
      ))}
    </div>
  </main>
</Teren>
